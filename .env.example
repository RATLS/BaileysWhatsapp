# Copy to .env and set a strong value (e.g. `openssl rand -hex 32`).
# Required: compose refuses to start without it.
REDIS_PASSWORD=

# ── Alerter (optional) ─────────────────────────────────────────────
# Google Chat space webhook (space menu → Apps & integrations → Webhooks).
# SECRET: anyone with this URL can post to the space. Never commit it.
# Leave empty to run in dry-run mode (alerts are only written to the log).
GOOGLE_CHAT_WEBHOOK_URL=
# Prefix shown on every message, e.g. "local" so test alerts are obvious.
ALERT_INSTANCE_NAME=
# Optional "Open dashboard" link added to messages.
ALERT_DASHBOARD_URL=
# Daily "all OK" message time (24h, ALERT_TIMEZONE). "off" disables it.
ALERT_DAILY_OK_TIME=10:00
ALERT_TIMEZONE=Asia/Kolkata
# Thresholds (defaults shown)
ALERT_DISCONNECT_GRACE_MS=180000
ALERT_QR_GRACE_MS=600000
ALERT_QUEUE_STUCK_MS=600000
ALERT_FAILURE_THRESHOLD=5
# System checks (always on): API/Redis down this long, worker silent this long,
# Redis memory / disk usage percentages.
ALERT_SYSTEM_GRACE_MS=60000
ALERT_WORKER_STALE_MS=120000
ALERT_REDIS_MEMORY_PCT=80
ALERT_DISK_PCT=85
